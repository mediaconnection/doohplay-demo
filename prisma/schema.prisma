datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PdfCertification {
  id            String   @id @default(uuid())
  pdfHash       String   @unique
  signature     String
  algorithm     String
  certifiedAt   DateTime @default(now())

  // 🔐 Jurídico
  generatedBy   String
  environment   String
  ipAddress     String?
  userAgent     String?

  // 🔗 Verificação futura
  publicKeyId   String

  createdAt    DateTime @default(now())
}
