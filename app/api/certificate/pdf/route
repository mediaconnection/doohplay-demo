export const dynamic = "force-dynamic"

import { NextRequest, NextResponse } from "next/server"
import { execSync } from "child_process"
import { writeFileSync, readFileSync, unlinkSync } from "fs"
import { tmpdir } from "os"
import { join } from "path"

const PYTHON_SCRIPT = `
import sys, json, io, datetime
from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.lib.units import mm
from reportlab.pdfgen import canvas
from reportlab.platypus import Table, TableStyle

def gen(data):
    buffer = io.BytesIO()
    w, h = A4
    c = canvas.Canvas(buffer, pagesize=A4)

    BRAND      = colors.HexColor("#0284C7")
    BRAND_DARK = colors.HexColor("#0369A1")
    GOLD       = colors.HexColor("#C9A84C")
    DARK       = colors.HexColor("#111827")
    MUTED      = colors.HexColor("#6B7280")
    LIGHT_BG   = colors.HexColor("#F9FAFB")
    BORDER     = colors.HexColor("#E5E7EB")
    GREEN      = colors.HexColor("#16A34A")
    PURPLE     = colors.HexColor("#7C3AED")
    BLUE_LIGHT = colors.HexColor("#BAE6FD")
    BLUE_BG    = colors.HexColor("#F0F9FF")

    # Header
    c.setFillColor(BRAND)
    c.rect(0, h-55*mm, w, 55*mm, fill=1, stroke=0)
    c.setFillColor(colors.white)
    c.setFont("Helvetica-Bold", 22)
    c.drawString(20*mm, h-22*mm, "DOOHPLAY")
    c.setFont("Helvetica", 9)
    c.drawString(20*mm, h-29*mm, "Trust Infrastructure for DOOH Advertising")
    c.setFont("Helvetica", 8)
    c.setFillColor(BLUE_LIGHT)
    c.drawRightString(w-20*mm, h-22*mm, "Certificado #" + data.get("cert_number","CERT"))
    c.drawRightString(w-20*mm, h-29*mm, data.get("issued_at",""))

    # Titulo
    c.setFillColor(DARK)
    c.setFont("Helvetica-Bold", 18)
    c.drawCentredString(w/2, h-75*mm, "CERTIFICADO DE VEICULACAO")
    c.setFont("Helvetica", 10)
    c.setFillColor(MUTED)
    c.drawCentredString(w/2, h-83*mm, "Comprovante oficial de exibicao com verificacao criptografica")
    c.setStrokeColor(BORDER)
    c.setLineWidth(0.5)
    c.line(20*mm, h-88*mm, w-20*mm, h-88*mm)

    y = h-100*mm

    # Box campanha
    c.setFillColor(LIGHT_BG)
    c.roundRect(20*mm, y-30*mm, w-40*mm, 32*mm, 4*mm, fill=1, stroke=0)
    c.setStrokeColor(BORDER); c.setLineWidth(0.3)
    c.roundRect(20*mm, y-30*mm, w-40*mm, 32*mm, 4*mm, fill=0, stroke=1)
    c.setFont("Helvetica-Bold", 8); c.setFillColor(BRAND)
    c.drawString(25*mm, y-5*mm, "CAMPANHA")
    c.setFont("Helvetica-Bold", 14); c.setFillColor(DARK)
    c.drawString(25*mm, y-13*mm, data.get("campaign_name",""))
    c.setFont("Helvetica", 9); c.setFillColor(MUTED)
    c.drawString(25*mm, y-20*mm, "Anunciante: " + data.get("advertiser",""))
    c.drawString(25*mm, y-26*mm, "Periodo: " + data.get("period",""))

    y -= 42*mm

    # Metricas
    metrics = [
        ("EXIBICOES VERIFICADAS", str(data.get("total_plays",0)), BRAND),
        ("DURACAO TOTAL", data.get("total_duration","0min"), BRAND_DARK),
        ("TELAS ATINGIDAS", str(data.get("screens_count",1)), PURPLE),
        ("SCORE CONFIANCA", "100/100", GREEN),
    ]
    box_w = (w-40*mm-9*mm)/4
    for i,(label,value,color) in enumerate(metrics):
        bx = 20*mm + i*(box_w+3*mm)
        c.setFillColor(LIGHT_BG)
        c.roundRect(bx, y-22*mm, box_w, 24*mm, 3*mm, fill=1, stroke=0)
        c.setStrokeColor(BORDER); c.setLineWidth(0.3)
        c.roundRect(bx, y-22*mm, box_w, 24*mm, 3*mm, fill=0, stroke=1)
        c.setFont("Helvetica-Bold", 16); c.setFillColor(color)
        c.drawCentredString(bx+box_w/2, y-10*mm, value)
        c.setFont("Helvetica", 7); c.setFillColor(MUTED)
        c.drawCentredString(bx+box_w/2, y-18*mm, label)

    y -= 34*mm

    # Tabela
    c.setFont("Helvetica-Bold", 10); c.setFillColor(DARK)
    c.drawString(20*mm, y, "Registro de exibicoes")
    c.setFont("Helvetica", 8); c.setFillColor(MUTED)
    c.drawString(20*mm, y-6*mm, "Cada linha possui hash SHA-256 unico e verificavel na blockchain Polygon Mainnet")
    y -= 12*mm

    plays = data.get("plays",[])[:10]
    tdata = [["#","Data / Hora","Tela","Dur.","Hash SHA-256"]]
    for i,p in enumerate(plays):
        h_str = (p.get("event_hash") or "")[:24]+"..."
        tdata.append([str(i+1), p.get("played_at",""), p.get("player_name",""), str(p.get("duration",""))+"s", h_str])

    if len(tdata) > 1:
        t = Table(tdata, colWidths=[10*mm,35*mm,40*mm,15*mm,60*mm])
        t.setStyle(TableStyle([
            ("BACKGROUND",(0,0),(-1,0),BRAND),
            ("TEXTCOLOR",(0,0),(-1,0),colors.white),
            ("FONTNAME",(0,0),(-1,0),"Helvetica-Bold"),
            ("FONTSIZE",(0,0),(-1,-1),7),
            ("FONTNAME",(0,1),(-1,-1),"Helvetica"),
            ("ROWBACKGROUNDS",(0,1),(-1,-1),[colors.white,LIGHT_BG]),
            ("TEXTCOLOR",(0,1),(-1,-1),DARK),
            ("GRID",(0,0),(-1,-1),0.3,BORDER),
            ("LEFTPADDING",(0,0),(-1,-1),4),
            ("RIGHTPADDING",(0,0),(-1,-1),4),
            ("TOPPADDING",(0,0),(-1,-1),3),
            ("BOTTOMPADDING",(0,0),(-1,-1),3),
            ("ALIGN",(0,0),(0,-1),"CENTER"),
            ("ALIGN",(3,0),(3,-1),"CENTER"),
        ]))
        t.wrapOn(c, w-40*mm, 200*mm)
        th = t._height
        t.drawOn(c, 20*mm, y-th)
        y -= th+8*mm

    # Blockchain box
    c.setFillColor(BLUE_BG)
    c.roundRect(20*mm, y-20*mm, w-40*mm, 22*mm, 3*mm, fill=1, stroke=0)
    c.setStrokeColor(BLUE_LIGHT); c.setLineWidth(0.5)
    c.roundRect(20*mm, y-20*mm, w-40*mm, 22*mm, 3*mm, fill=0, stroke=1)
    c.setFont("Helvetica-Bold", 9); c.setFillColor(BRAND_DARK)
    c.drawString(25*mm, y-7*mm, "Verificacao Blockchain")
    c.setFont("Helvetica", 8); c.setFillColor(MUTED)
    c.drawString(25*mm, y-13*mm, "Rede: Polygon Mainnet  |  Algoritmo: SHA-256  |  Protocolo: TSA RFC3161  |  ICP-Brasil")
    url = "https://doohplay-demo.onrender.com/verify/" + data.get("demo_hash","")
    c.setFillColor(BRAND)
    c.drawString(25*mm, y-18*mm, "Verificar: " + url)

    # Footer
    c.setFillColor(DARK)
    c.rect(0, 0, w, 18*mm, fill=1, stroke=0)
    c.setFont("Helvetica", 7); c.setFillColor(colors.HexColor("#9CA3AF"))
    c.drawCentredString(w/2, 11*mm, "DOOHPLAY - Trust Infrastructure for DOOH Advertising")
    c.drawCentredString(w/2, 7*mm, "Certificado gerado em " + data.get("issued_at","") + "  |  Validade legal conforme Lei 14.063/2020")
    c.drawCentredString(w/2, 3*mm, "doohplay-demo.onrender.com")

    c.save()
    return buffer.getvalue()

data = json.loads(sys.argv[1])
pdf = gen(data)
sys.stdout.buffer.write(pdf)
`

export async function POST(request: NextRequest) {
  try {
    const data = await request.json()

    // Write Python script to tmp
    const tmpScript = join(tmpdir(), `cert_${Date.now()}.py`)
    const tmpData = join(tmpdir(), `cert_data_${Date.now()}.json`)

    writeFileSync(tmpScript, PYTHON_SCRIPT)
    writeFileSync(tmpData, JSON.stringify(data))

    // Execute Python
    const pdfBuffer = execSync(`python3 ${tmpScript} '${JSON.stringify(data).replace(/'/g, "'\\''")}'`, {
      maxBuffer: 10 * 1024 * 1024,
      timeout: 30000,
    })

    // Cleanup
    try { unlinkSync(tmpScript) } catch {}
    try { unlinkSync(tmpData) } catch {}

    return new NextResponse(pdfBuffer, {
      headers: {
        "Content-Type": "application/pdf",
        "Content-Disposition": 'inline; filename="certificado.pdf"',
      }
    })

  } catch (err: any) {
    console.error("PDF generation error:", err)
    return NextResponse.json({ error: err.message }, { status: 500 })
  }
}
