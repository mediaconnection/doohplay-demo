{
    "compilerOptions":  {
                            "target":  "ES2017",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "types":  [
                                          "node",
                                          "jest"
                                      ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*",
                                                      "./*"
                                                  ],
                                          "@/components/*":  [
                                                                 "./components/*",
                                                                 "./src/components/*"
                                                             ]
                                      },
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "ts-node":  {
                    "compilerOptions":  {
                                            "module":  "commonjs",
                                            "moduleResolution":  "node"
                                        }
                },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    "**/*.mts",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts",
                    "types/**/*.d.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "scripts"
                ]
}
